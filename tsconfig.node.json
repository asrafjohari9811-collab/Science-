  "include": ["scripts/generate-content-sql.ts", "src/lib/content/**/*.ts", "src/lib/grading.ts", "src/lib/progress.ts", "src/lib/sync/queue.ts", "tests/unit/**/*.ts", "src/lib/sync/queue.ts"]
}
